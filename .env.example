# ==========================================
# DSpace 10 Docker Environment Configuration
# ==========================================
# Salin file ini menjadi `.env` lalu sesuaikan dengan kebutuhan domain/port server Anda.
# `cp .env.example .env`

# ------------------------------------------
# Project & Container Settings
# ------------------------------------------
# Nama prefix project Docker Compose (default: d10)
COMPOSE_PROJECT_NAME=d10

# Versi DSpace Docker Image (default: latest)
DSPACE_VER=latest

# Versi PostgreSQL Image (default: 15)
POSTGRES_VERSION=15

# ------------------------------------------
# Custom Frontend UI Settings (Opsional)
# ------------------------------------------
# Jika ingin build dari repository Git custom sendiri:
FRONTEND_REPO=https://github.com/DSpace/dspace-angular.git
FRONTEND_BRANCH=main

# Atau jika menggunakan image pre-built dari Docker Registry sendiri (opsional):
# DSPACE_UI_IMAGE=ghcr.io/username/custom-dspace-ui:latest

# ------------------------------------------
# Public Port & Domain Settings (Nginx Reverse Proxy)
# ------------------------------------------
# Port Nginx yang diexpose ke host server (ganti jika port 80 sudah terpakai, contoh: 8081)
NGINX_HOST_PORT=80

# URL publik lengkap untuk Backend REST API & Frontend Angular UI
DSPACE_SERVER_URL=https://repository.stikomtunasbangsa.ac.id/server
DSPACE_UI_URL=https://repository.stikomtunasbangsa.ac.id

# Hostname domain publik untuk browser
DSPACE_REST_HOST=repository.stikomtunasbangsa.ac.id

# Port publik utama yang diakses browser (443 jika HTTPS, 80 jika HTTP, atau 8081 jika port custom)
DSPACE_REST_PORT=443

# SSL flag untuk REST API (true jika mengakses via HTTPS Cloudflare / Proxy)
DSPACE_REST_SSL=true

# Catatan: SSL container UI internal selalu `false` karena SSL di-terminate oleh Nginx / Cloudflare
DSPACE_UI_SSL=false

# ------------------------------------------
# SMTP Email Configuration (Pengiriman Email DSpace)
# ------------------------------------------
# Default: true (matikan pengiriman email jika belum dikonfigurasi agar login tidak crash)
# Ubah ke `false` JIKA DAN HANYA JIKA SMTP_USER & SMTP_PASS sudah diisi dengan benar.
SMTP_DISABLED=true

# Server Host SMTP (Contoh: smtp.gmail.com, mail.kampus.ac.id, smtp.mailtrap.io)
SMTP_HOST=smtp.gmail.com

# Port SMTP (587 untuk TLS/STARTTLS, 465 untuk SSL, 25 untuk non-encrypted)
SMTP_PORT=587

# Username / Alamat Email pengirim SMTP
SMTP_USER=emailanda@gmail.com

# Password / App Password SMTP (Gunakan Google App Password jika menggunakan Gmail)
SMTP_PASS=password_atau_app_password_anda

# Alamat Email pengirim di header email ("From:")
SMTP_FROM_ADDRESS=noreply@repository.stikomtunasbangsa.ac.id

# Alamat Email penerima masukan / feedback Form
SMTP_FEEDBACK_RECIPIENT=admin@repository.stikomtunasbangsa.ac.id

# Alamat Email Administrator DSpace
SMTP_ADMIN_EMAIL=admin@repository.stikomtunasbangsa.ac.id

# ------------------------------------------
# Database Configuration
# ------------------------------------------
# Port PostgreSQL yang diexpose ke Host (Beekeeper Studio, pgAdmin, dll)
# Default 5431 agar TIDAK bentrok dengan PostgreSQL bawaan server (port 5432)
DB_HOST_PORT=5431

# Kredensial internal PostgreSQL
POSTGRES_DB=dspace
POSTGRES_USER=dspace
POSTGRES_PASSWORD=dspace
