# =============================================================
# Dockerfile.warp
# Cloudflare WARP dalam proxy mode (TIDAK butuh /dev/net/tun).
# socat merelay 0.0.0.0:1080 → 127.0.0.1:40000 (warp-svc SOCKS5)
# =============================================================
FROM debian:bookworm-slim

# ── 1. Install dependencies dasar ────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    gnupg \
    iproute2 \
    socat \
    netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

# ── 2. Tambah repo resmi Cloudflare WARP dan install warp-cli ─
RUN curl -fsSL https://pkg.cloudflareclient.com/pubkey.gpg \
      | gpg --yes --dearmor -o /usr/share/keyrings/cloudflare-warp-archive-keyring.gpg \
    && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/cloudflare-warp-archive-keyring.gpg] \
      https://pkg.cloudflareclient.com/ bookworm main" \
      > /etc/apt/sources.list.d/cloudflare-client.list \
    && apt-get update && apt-get install -y --no-install-recommends \
      cloudflare-warp \
    && rm -rf /var/lib/apt/lists/*

# ── 3. Copy entrypoint ────────────────────────────────────────
COPY docker/warp-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# ── 4. Direktori data WARP ────────────────────────────────────
VOLUME ["/var/lib/cloudflare-warp"]

# Port relay socat (expose warp-svc ke docker network)
EXPOSE 1080

ENTRYPOINT ["/entrypoint.sh"]
