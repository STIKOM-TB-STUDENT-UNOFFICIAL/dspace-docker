# ====================================================================
# DSpace 10 Local Configuration (local.cfg)
# ====================================================================
dspace.server.url = https://repository.stikomtunasbangsa.ac.id/server
dspace.ui.url = https://repository.stikomtunasbangsa.ac.id
dspace.name = Repositori Institusi STIKOM Tunas Bangsa

# --------------------------------------------------------------------
# Mail / SMTP Configuration
# --------------------------------------------------------------------
# ARSITEKTUR:
#   DSpace → smtp-relay:25 (container lokal, tidak ada blokir ISP)
#   smtp-relay → proxychains4 → WARP SOCKS5 → smtp.gmail.com:587
#
# DSpace TIDAK perlu tahu tentang WARP atau proxy.
# Kredensial Gmail dikonfigurasi di smtp-relay (docker-compose.yml env).

mail.server.disabled = false

# Arahkan ke smtp-relay container (bukan langsung ke Gmail)
mail.server = smtp-relay
mail.server.port = 25

# Kosongkan username/password karena smtp-relay tidak pakai auth
# (auth dilakukan oleh msmtp ke Gmail di belakang layar)
mail.server.username =
mail.server.password =

mail.from.address = noreply@repository.stikomtunasbangsa.ac.id
mail.feedback.recipient = admin@repository.stikomtunasbangsa.ac.id
mail.admin = admin@repository.stikomtunasbangsa.ac.id

# Tidak perlu STARTTLS/SSL karena koneksi ke relay adalah lokal (port 25)
# mail.extraproperties =
