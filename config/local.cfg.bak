# ====================================================================
# DSpace 10 Local Configuration (local.cfg)
# ====================================================================
# File ini di-mount ke /dspace/config/local.cfg di dalam container.
# Semua opsi di sini akan menimpa (override) konfigurasi bawaan DSpace.
# Mount path di docker-compose.yml: ./config/local.cfg

# --------------------------------------------------------------------
# Server URLs & Domain Configuration
# --------------------------------------------------------------------
# WAJIB diisi sesuai domain publik! Jika salah, semua link REST API
# akan menggunakan protokol/domain yang salah -> Mixed Content Error.
dspace.server.url = https://repository.stikomtunasbangsa.ac.id/server
dspace.ui.url = https://repository.stikomtunasbangsa.ac.id

# Nama repositori - muncul di title halaman UI, email, dan halaman About.
dspace.name = Repositori Institusi STIKOM Tunas Bangsa

# --------------------------------------------------------------------
# Mail / SMTP Configuration
# --------------------------------------------------------------------
# CATATAN: Traffic SMTP dirutekan lewat Cloudflare WARP (SOCKS5 proxy)
# melalui JAVA_OPTS di docker-compose.yml agar bypass blokir ISP.
#
# Set ke `false` untuk MENGAKTIFKAN pengiriman email
mail.server.disabled = false

# Host server SMTP
mail.server = smtp.gmail.com

# Port SMTP (587 untuk STARTTLS - direkomendasikan untuk Gmail)
mail.server.port = 587

# Username / Alamat Email pengirim SMTP (Gmail)
mail.server.username = emailanda@gmail.com

# Password / App Password SMTP
# PENTING: Gunakan Google App Password (bukan password akun biasa)
# Buat di: https://myaccount.google.com/apppasswords
mail.server.password = xxxx xxxx xxxx xxxx

# Header "From:" pada email yang dikirim
mail.from.address = noreply@repository.stikomtunasbangsa.ac.id

# Penerima email masukan (Feedback Form)
mail.feedback.recipient = admin@repository.stikomtunasbangsa.ac.id

# Email Administrator DSpace
mail.admin = admin@repository.stikomtunasbangsa.ac.id

# Opsi Tambahan JavaMail - wajib untuk Gmail dengan STARTTLS
mail.extraproperties = mail.smtp.auth=true, mail.smtp.starttls.enable=true
